{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simgrammar.dev/schema/1.3/game.schema.json",
  "title": "Game",
  "description": "A simulation game (or boundary case included for its mechanics). Owns `uses` edges to mechanics and `influenced_by` edges to earlier games.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "type",
    "name",
    "summary",
    "year",
    "developer",
    "platforms",
    "subgenre",
    "sim_domain",
    "player_role",
    "agency_model",
    "time_model",
    "sim_scale",
    "fidelity",
    "perspective",
    "win_structure",
    "failure_model",
    "narrative_mode",
    "multiplayer",
    "modding",
    "production_tier",
    "agent_count_order",
    "emergence",
    "influence",
    "core_loop",
    "mechanics",
    "status",
    "provenance"
  ],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "type": {
      "const": "game"
    },
    "name": {
      "$ref": "common.schema.json#/$defs/name"
    },
    "aliases": {
      "$ref": "common.schema.json#/$defs/aliases"
    },
    "summary": {
      "$ref": "common.schema.json#/$defs/summary"
    },
    "year": {
      "$ref": "common.schema.json#/$defs/year",
      "description": "First public release, including early access."
    },
    "year_full_release": {
      "$ref": "common.schema.json#/$defs/year",
      "description": "1.0 release year when it differs from `year`."
    },
    "developer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "x-vocab": "platform"
      }
    },
    "subgenre": {
      "type": "string",
      "x-vocab": "subgenre"
    },
    "subgenre_secondary": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 3,
      "items": {
        "type": "string",
        "x-vocab": "subgenre"
      }
    },
    "sim_domain": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "x-vocab": "sim_domain"
      }
    },
    "player_role": {
      "type": "string",
      "x-vocab": "player_role"
    },
    "agency_model": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "x-vocab": "agency_model"
      }
    },
    "time_model": {
      "type": "string",
      "x-vocab": "time_model"
    },
    "sim_scale": {
      "type": "string",
      "x-vocab": "sim_scale"
    },
    "fidelity": {
      "type": "string",
      "x-vocab": "fidelity"
    },
    "perspective": {
      "type": "string",
      "x-vocab": "perspective"
    },
    "win_structure": {
      "type": "string",
      "x-vocab": "win_structure"
    },
    "failure_model": {
      "type": "string",
      "x-vocab": "failure_model"
    },
    "narrative_mode": {
      "type": "string",
      "x-vocab": "narrative_mode"
    },
    "multiplayer": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "x-vocab": "multiplayer"
      }
    },
    "modding": {
      "type": "string",
      "x-vocab": "modding"
    },
    "production_tier": {
      "type": "string",
      "x-vocab": "production_tier"
    },
    "agent_count_order": {
      "type": "string",
      "x-vocab": "agent_count_order"
    },
    "emergence": {
      "$ref": "common.schema.json#/$defs/score",
      "x-rubric": "emergence"
    },
    "influence": {
      "$ref": "common.schema.json#/$defs/score",
      "x-rubric": "influence"
    },
    "boundary_case": {
      "type": "boolean",
      "description": "True when the work fails part (b) of the game inclusion test in AGENTS.md (its core loop is not driven by a simulated system) but is included for specific mechanics."
    },
    "core_loop": {
      "type": "string",
      "minLength": 20,
      "maxLength": 400,
      "description": "Arrow-separated loop: 'zone land -> citizens arrive -> demand shifts -> tax income -> expand'."
    },
    "design_notes": {
      "$ref": "common.schema.json#/$defs/text"
    },
    "mechanics": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "role"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id",
            "x-edge": "uses"
          },
          "role": {
            "type": "string",
            "x-vocab": "mechanic_role"
          },
          "note": {
            "type": "string",
            "minLength": 5,
            "maxLength": 500,
            "description": "How this game implements the mechanic. Required for core mechanics."
          }
        }
      }
    },
    "influenced_by": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/id",
        "x-edge": "influenced_by"
      }
    },
    "store_ids": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "description": "External identifiers so other datasets (platforms, themes, sales) can join on this game. Checked against the store by scripts/check_sources.py.",
      "properties": {
        "steam": {
          "type": "integer",
          "minimum": 1,
          "description": "Steam app id, from store.steampowered.com/app/<id>."
        },
        "igdb": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "description": "IGDB slug, from igdb.com/games/<slug>."
        },
        "wikidata": {
          "type": "string",
          "pattern": "^Q[1-9][0-9]*$",
          "description": "Wikidata item id of the game."
        }
      }
    },
    "assertions": {
      "$ref": "common.schema.json#/$defs/assertions"
    },
    "ratings": {
      "$ref": "common.schema.json#/$defs/ratings"
    },
    "claims": {
      "$ref": "common.schema.json#/$defs/claims"
    },
    "sources": {
      "$ref": "common.schema.json#/$defs/sources"
    },
    "status": {
      "$ref": "common.schema.json#/$defs/status"
    },
    "deprecated": {
      "$ref": "common.schema.json#/$defs/deprecated"
    },
    "provenance": {
      "$ref": "common.schema.json#/$defs/provenance"
    }
  }
}
