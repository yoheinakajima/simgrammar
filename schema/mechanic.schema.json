{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simgrammar.dev/schema/1.3/mechanic.schema.json",
  "title": "Mechanic",
  "description": "An atomic, nameable, tunable, removable rule-system. Owns requires/specializes/synergy/tension edges. Never lists games or techniques (those edges are owned elsewhere).",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "name", "summary", "family", "substrate", "definition", "player_experience", "design_levers", "failure_modes", "dynamics", "math_basis", "feedback", "player_interface", "legibility", "emergence_potential", "authoring_cost", "compute_cost", "tuning_difficulty", "ai_leverage", "maturity", "status", "provenance"],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "type": { "const": "mechanic" },
    "name": { "$ref": "common.schema.json#/$defs/name" },
    "aliases": { "$ref": "common.schema.json#/$defs/aliases" },
    "summary": { "$ref": "common.schema.json#/$defs/summary" },
    "family": { "type": "string", "x-vocab": "mechanic_family" },
    "substrate": { "type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": { "type": "string", "x-vocab": "substrate" } },
    "definition": { "type": "string", "minLength": 40, "maxLength": 1200, "description": "Rule-level description: state owned, update rule, inputs, outputs." },
    "player_experience": { "type": "string", "minLength": 20, "maxLength": 800, "description": "What the mechanic makes the player feel and do." },
    "design_levers": { "$ref": "common.schema.json#/$defs/text_list", "minItems": 2, "description": "Tunable parameters or design choices." },
    "failure_modes": { "$ref": "common.schema.json#/$defs/text_list", "minItems": 1, "description": "Common ways the mechanic goes wrong in shipped games." },
    "dynamics": { "$ref": "common.schema.json#/$defs/text_list", "minItems": 1, "description": "Emergent behaviors it produces in play." },
    "math_basis": { "type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": { "type": "string", "x-vocab": "math_basis" } },
    "feedback": { "type": "string", "x-vocab": "feedback" },
    "player_interface": { "type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": { "type": "string", "x-vocab": "player_interface" } },
    "legibility": { "$ref": "common.schema.json#/$defs/score", "x-rubric": "legibility" },
    "emergence_potential": { "$ref": "common.schema.json#/$defs/score", "x-rubric": "emergence_potential" },
    "authoring_cost": { "$ref": "common.schema.json#/$defs/score", "x-rubric": "authoring_cost" },
    "compute_cost": { "$ref": "common.schema.json#/$defs/score", "x-rubric": "compute_cost" },
    "tuning_difficulty": { "$ref": "common.schema.json#/$defs/score", "x-rubric": "tuning_difficulty" },
    "ai_leverage": { "$ref": "common.schema.json#/$defs/score", "x-rubric": "ai_leverage" },
    "maturity": { "type": "string", "x-vocab": "maturity" },
    "requires": { "type": "array", "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/id", "x-edge": "requires" } },
    "specializes": { "$ref": "common.schema.json#/$defs/id", "x-edge": "specializes" },
    "synergy": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "note"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id", "x-edge": "synergy" },
          "note": { "type": "string", "minLength": 5, "maxLength": 400 }
        }
      }
    },
    "tension": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "note"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id", "x-edge": "tension" },
          "note": { "type": "string", "minLength": 5, "maxLength": 400 }
        }
      }
    },
    "open_questions": { "$ref": "common.schema.json#/$defs/text_list" },
    "assertions": { "$ref": "common.schema.json#/$defs/assertions" },
    "ratings": { "$ref": "common.schema.json#/$defs/ratings" },
    "claims": { "$ref": "common.schema.json#/$defs/claims" },
    "sources": { "$ref": "common.schema.json#/$defs/sources" },
    "status": { "$ref": "common.schema.json#/$defs/status" },
    "deprecated": { "$ref": "common.schema.json#/$defs/deprecated" },
    "provenance": { "$ref": "common.schema.json#/$defs/provenance" }
  }
}
